DATABASE_URL=sqlite://zenith.db
DATABASE_URL=sqlite://zenith.db
ZENITH_ENV=development
# Comma-separated Stellar public keys. These wallets are bootstrapped as super_admin.
ZENITH_SUPER_ADMIN_WALLETS=
ZENITH_RETENTION_DAYS=90

# Cache backend for expensive, shareable computations (option chains, the
# spot/vol surface, expiry calendars, protocol stats, wallet readiness).
# "moka" (default) is an in-process cache; "redis" shares one across replicas.
# ZENITH_CACHE=redis
# ZENITH_REDIS_URL=redis://localhost:6379
# ZENITH_CACHE_TTL_SECS=60
# ZENITH_CACHE_MOKA_CAPACITY=10000

# Optional. When unavailable, rate limiting falls back to a per-process GCRA store.
REDIS_URL=redis://localhost:6379/0

# ─── Analytics export (zenith-admin export run) ─────────────────────────────
# Directory the Parquet exports are written to (stands in for object storage).
EXPORT_DIR=./exports
# Salt for hashing wallet addresses in the export. Set this to a
# per-deployment secret so hashes can't be correlated across deployments.
EXPORT_WALLET_SALT=zenith-analytics-export-v1
# Set to "true" to export raw wallet addresses instead of hashed ones.
# Hashed (the default) is the PII-safe choice; raw is opt-in only.
EXPORT_RAW_WALLETS=false

ZENITH_BIND_ADDRESS=0.0.0.0:8081
# Required for the operator-only settlement dashboard; leave unset to fail closed.
ZENITH_OPERATOR_TOKEN=
ZENITH_NONCE_TTL_SECS=300
ZENITH_SESSION_TTL_SECS=86400
ZENITH_MAX_PCT_MOVE_PER_TICK=0.003
ZENITH_AUTH_RATE_LIMIT_PER_SECOND=2
ZENITH_AUTH_RATE_LIMIT_BURST=10
ZENITH_MUTATION_RATE_LIMIT_PER_SECOND=5
ZENITH_MUTATION_RATE_LIMIT_BURST=20
# Required for per-series halt, resume, delist, early settlement and payoff changes.
# Leave unset to keep operator actions disabled.
OPERATOR_API_TOKEN=
# Optional JSON object overrides:
# ZENITH_SEEDED_PRICES={"XLM":0.1182,"BTC":67420.5,"ETH":3512.8,"SOL":182.45}
# ZENITH_SEEDED_VOLS={"XLM":0.82,"BTC":0.65,"ETH":0.72,"SOL":0.91}
# Deprecation policy is opt-in; configure all three values to enable headers:
# ZENITH_DEPRECATED_ROUTES=["/api/v1/spot"]
# ZENITH_DEPRECATION_TIMESTAMP=1799539200
# ZENITH_SUNSET_DATE=Sun, 10 Jan 2027 00:00:00 GMT

# Optional outbound notification providers:
# DELIVERY_EMAIL_API_URL=https://provider.example/api/send
# DELIVERY_EMAIL_API_TOKEN=
# DELIVERY_EMAIL_FROM=notifications@example.com
# Settlement lifecycle push notifications (docs/notifications.md):
# NOTIFY_PUSH_GATEWAY_URL=https://push.example/api/send
# NOTIFY_PUSH_GATEWAY_TOKEN=
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=

# ─── Observability (OpenTelemetry) ──────────────────────────────────────────
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=zenith-backend

# ─── Soroban inclusion-fee strategy (see docs/chain-fees.md) ─────────────────
# The inclusion fee is the percentile of the fees recently paid on the
# network, clamped between a floor and a ceiling. All amounts are in stroops
# (1 XLM = 1_000_000 stroops).
# Percentile of the recent inclusion-fee distribution to bid (1..=100).
# ZENITH_FEE_PERCENTILE=90
# Lower bound of the inclusion-fee bid.
# ZENITH_FEE_FLOOR_STROOPS=100
# Upper bound of the inclusion-fee bid.
# ZENITH_FEE_CEILING_STROOPS=100000
# Upper bound of the *total* fee (resource fee + inclusion fee) paid for one
# transaction.
# ZENITH_FEE_PER_TX_CAP_STROOPS=500000
# Rolling 24h budget for inclusion fees. Submissions are blocked once the
# budget is exhausted.
# ZENITH_FEE_DAILY_BUDGET_STROOPS=5000000
# How often the fee statistics are refreshed, in seconds.
# ZENITH_FEE_POLL_INTERVAL_SECS=15
# How long a cached fee sample stays fresh, in seconds.
# ZENITH_FEE_CACHE_TTL_SECS=30

# ─── Event indexer and backfill (see docs/indexer-backfill.md) ───────────────
# Number of ledgers replayed per backfill range.
# ZENITH_INDEXER_MAX_RANGE=1000
# Number of ledgers fetched per event page.
# ZENITH_INDEXER_PAGE_LIMIT=200
# Pause between two event pages, in milliseconds (RPC rate limit).
# ZENITH_INDEXER_RATE_LIMIT_MS=100
# How often the indexer polls the chain tip, in seconds.
# ZENITH_INDEXER_POLL_INTERVAL_SECS=5
# Name of the indexed stream.
# ZENITH_INDEXER_STREAM=zenith

# ─── Secrets (see docs/secrets-rotation.md) ───────────────────────────────────
# Which SecretProvider to use: "env" (default), "sops" or "vault".
ZENITH_SECRET_BACKEND=env
# SOPS backend:
SOPS_FILE=secrets.enc.yaml
# Vault backend:
VAULT_ADDR=https://vault.example:8200
VAULT_TOKEN=
VAULT_SECRET_MOUNT=secret
# HMAC key rings. `*_PREVIOUS` is optional and only set during a rotation
# window, during which signatures made with the old key still verify.
CURSOR_HMAC_KEY=
CURSOR_HMAC_KEY_PREVIOUS=
WEBHOOK_HMAC_KEY=
WEBHOOK_HMAC_KEY_PREVIOUS=
# ─── Stellar channel-account pool (settlement submission) ────────────────────
# Comma-separated list of Stellar secret keys (S...) for the pooled channel
# accounts used to submit settlements concurrently. Secrets are resolved via
# the configured SecretProvider/SecretStore (see ZENITH_SECRET_BACKEND above);
# they are never read directly from the environment by the chain module.
# ZENITH_CHANNEL_ACCOUNTS=
# Lease TTL (seconds) after which an unreleased channel account is reclaimed
# by the background reaper so a crashed worker cannot strand it.
ZENITH_OPTIONS_CONTRACT_TESTNET=
ZENITH_VAULT_CONTRACT_TESTNET=
ZENITH_ORACLE_CONTRACT_TESTNET=
SOROBAN_RPC_URL=
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
SOROBAN_RPC_TIMEOUT_MS=5000
STELLAR_FRIENDBOT_ENABLED=false
CHAIN_MODE=paper
CHAIN_READINESS_MAX_LAG_LEDGERS=12
CHAIN_READINESS_FAILURE_HYSTERESIS=3
CHAIN_SUBMISSIONS_ENABLED=false
CHAIN_MAX_FEE_STROOPS=1000000
CHAIN_MAX_AMOUNT_STROOPS=100000000000
CHAIN_WINDOW_AMOUNT_STROOPS=500000000000

# Soroban protocol compatibility gate (docs/runbooks/network-upgrade.md)
# ZENITH_EXPECTED_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# ZENITH_CONTRACT_SDK_VERSION=22.0.0
# ZENITH_CONTRACT_MIN_PROTOCOL=22
# ZENITH_CONTRACT_MAX_PROTOCOL=23
# ZENITH_SCHEDULED_UPGRADE=24@1793984400
# ZENITH_UPGRADE_DEPLOY_FREEZE_SECS=86400
# ZENITH_PROTOCOL_WEBHOOK_URL=

# Operator token for GET /api/v1/admin/tx-forensics (failed-transaction
# diagnostics). The endpoint returns 503 while unset.
# ZENITH_ADMIN_TOKEN=
